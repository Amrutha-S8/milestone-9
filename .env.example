# ── Provider Configuration ─────────────────────────────────────────
OPENAI_API_KEY=
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus
AZURE_TTS_VOICE=en-IN-NeerjaNeural
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2-general
GOOGLE_APPLICATION_CREDENTIALS=
ANTHROPIC_API_KEY=
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=float16
GPT4O_MODEL=gpt-4o
CLAUDE_MODEL=claude-3-opus-20240229
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ── Storage ────────────────────────────────────────────────────────
STORAGE_TYPE=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=stayza
PGUSER=stayza
PGPASSWORD=
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=20
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=stayza-reports

# ── Security ───────────────────────────────────────────────────────
STAYZA_API_KEYS=
STAYZA_CORS_ORIGINS=*
STAYZA_DISABLE_API_AUTH=false
STAYZA_RATE_LIMIT_MAX=100
STAYZA_RATE_LIMIT_WINDOW=60

# ── Logging ────────────────────────────────────────────────────────
STAYZA_LOG_DIR=logs
STAYZA_LOG_LEVEL=INFO
STAYZA_LOG_MAX_BYTES=10485760
STAYZA_LOG_BACKUP_COUNT=10

# ── Backup ─────────────────────────────────────────────────────────
STAYZA_BACKUP_DIR=backup
STAYZA_MAX_BACKUPS=30
STAYZA_BACKUP_COMPRESS=true

# ── Server ─────────────────────────────────────────────────────────
STAYZA_HOST=0.0.0.0
STAYZA_PORT=8000
STAYZA_WORKERS=4
STAYZA_RELOAD=false
